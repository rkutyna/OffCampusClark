LISTEN_NGINX_HTTP=127.0.0.1:8080
LISTEN_NGINX_HTTPS=127.0.0.1:8484

# Database configuration
POSTGRES_USER=django
POSTGRES_PASSWORD=RANDOM_PASSWORD
POSTGRES_DB=django_data

# The Nginx configuration file. Has the server name, paths to SSL certs, etc.
NGINX_CONFIG=default.development.conf
#NGINX_CONFIG=default.production.conf

DJANGO_SECRET_KEY=SOMETHING_LONG_AND_RANDOM
# Should be kept False on public-facing servers. Gives full stack traces and
# disables certain security safeguards. Change to True for local debugging.
DJANGO_DEBUG=False

# A comma-separated list of hostnames that are allowed to access the application.
# For local development, you might use: 127.0.0.1,localhost
# For production, you would add your public domain(s): example.clarku.edu,www.example.clarku.edu
ALLOWED_HOSTS_FROM_ENV=127.0.0.1,localhost

# A comma-separated list of trusted origins for POST requests (e.g., for logins).
# The full scheme (https://) is required.
# For example: https://offcampus-demo-rk.site,https://another-domain.com
CSRF_TRUSTED_ORIGINS_FROM_ENV=https://offcampus-demo-rk.site